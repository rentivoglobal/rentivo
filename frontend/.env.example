# Supabase (required in production)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ImageKit (public only — private key stays in Edge Functions)
VITE_IMAGEKIT_PUBLIC_KEY=public_xxxxx
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Paystack (public only — secret key stays in Edge Functions)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# App
VITE_APP_URL=http://localhost:5173
VITE_ACCESS_FEE_KOBO=500000
VITE_PROMO_CAP=100

# Local QA only. Never enable in production.
VITE_DEMO_SIMULATOR=false
